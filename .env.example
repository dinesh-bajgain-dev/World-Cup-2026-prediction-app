# Copy this file to .env and fill in your values.
# ALL of these must also be added to Vercel → Project → Settings → Environment Variables.
#
# Supabase  → https://app.supabase.com → Project → Settings → API
# Brevo     → https://app.brevo.com → SMTP & API → API Keys
# Sender    → Brevo → Senders & IP → Senders  (must be Verified before use)

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

BREVO_API_KEY=xkeysib-YOUR_KEY_HERE
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=World Cup 2026 Predictor

# Optional — defaults to window.location.origin in dev
# VITE_APP_URL=https://your-production-domain.com
